# OpenBoard configuration. Copy this file to .env and fill in real values.

# Required. PostgreSQL connection string for the application database.
# Required in production. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

DATABASE_URL=postgres://openboard:openboard@localhost:5432/openboard

# Required. Public origin of the deployment. Used for URLs and CSRF checks.
ORIGIN=http://localhost:3000

# Optional. HTTP server bind port and address. Defaults shown.
PORT=3000
HOST=0.0.0.0

# Optional. Web Push credentials for move and challenge notifications.
# Generate a key pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Optional. SMTP for outgoing email: password-reset mail, address
# verification, and correspondence reminder mail. Everything degrades
# gracefully without it: administrators can hand out single-use reset codes
# from /admin/users, and deadline reminders stay in-app. Email turns on when
# both SMTP_HOST and SMTP_FROM are set; SMTP_PORT defaults to 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=OpenBoard <no-reply@example.com>

# Optional. OIDC single sign-on provider. Leave empty to use password auth only.
OIDC_ISSUER_URL=https://idp.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=
